{
  "name": "dsh-model-memory",
  "version": "0.1.11",
  "description": "DSH 自定义模型思考等级管理与偏好记忆插件：原生设计语言、全档位思考配置与无感隔离式跨会话偏好记忆。",
  "author": "Mutx163",
  "license": "MIT",
  "homepage": "https://github.com/Mutx163/dsh-model-memory#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mutx163/dsh-model-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Mutx163/dsh-model-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "thinking-level",
    "model-memory",
    "cordis",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsdown",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "js-yaml": "^5.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-host-apiproxy": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <3.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.1",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
